# ---- Sovereign AI Workbench :: Environment Config ----
# All endpoints below MUST resolve to localhost / LAN only. No public DNS.

APP_ENV=onprem
APP_HOST=0.0.0.0
APP_PORT=8000

# Local model runtime (Ollama / vLLM / TGI - all OpenAI-compatible local servers)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=not-needed-local

# Model registry - map logical roles to locally pulled model tags
MODEL_CODE=qwen2.5-coder:32b
MODEL_REASONING=deepseek-r1:32b
MODEL_GENERAL=qwen2.5:32b-instruct
MODEL_VISION=qwen2.5-vl:7b
MODEL_SMALL_FAST=phi4:14b

# Vector DB (local, embedded - Chroma persists to disk, no network)
CHROMA_PERSIST_DIR=./data/chroma_store

# Sandbox
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEM_LIMIT_MB=1024

# Network Sentinel - interface to monitor for egress proof
NET_MONITOR_INTERFACE=auto
NET_MONITOR_ALLOWLIST=127.0.0.1,localhost,::1

# Storage
UPLOAD_DIR=./data/uploads
DELIVERABLE_DIR=./data/deliverables
DB_PATH=./data/workbench.db
